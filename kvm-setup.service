[Unit]
Description=KVM host first-boot setup
After=network-online.target
Wants=network-online.target
Before=getty@tty1.service
ConditionPathExists=!/var/lib/kvm-setup.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kvm-setup
Environment=TERM=linux
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
